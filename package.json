{
  "name": "keos-room",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start --workspace=@keos/bridge",
    "dev:bridge": "npm run dev --workspace=@keos/bridge",
    "dev:web": "npm run dev --workspace=@keos/web",
    "dev": "npm run dev:bridge",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspace=@keos/bridge",
    "test:visual": "npm run test:visual --workspace=@keos/web"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
